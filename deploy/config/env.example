# Reference only. Copy to config/.<profile>.env on the server and fill real
# secrets from the deployment secret store. Do not commit profile env files and
# do not put secrets into JAVA_OPTS, because JVM arguments are visible in ps.
# Because this file is sourced by Bash, wrap passwords, JWT secrets, API keys,
# and similar secret values in single quotes in the real profile env file.
# This is mandatory when a value contains $, !, spaces, backticks, &, |, ;, <, or >.

APP_PROFILE=dev
SERVER_PORT=10080

# The start script validates JDK 21. Set this explicitly when the server
# default JAVA_HOME points to another JDK version.
CARD_SHOP_TRADE_JAVA_HOME=
JAVA_OPTS="-Xms512m -Xmx512m -XX:+UseG1GC -Dfile.encoding=UTF-8"

NACOS_SERVER_ADDR=<nacos-host>:8848
NACOS_NAMESPACE=cardshop-trade-engine-dev
NACOS_GROUP=TRADE_ENGINE_DEV
NACOS_USERNAME=nacos
NACOS_PASSWORD='change-me'

SPRING_RABBITMQ_HOST=<rabbitmq-host>
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=<rabbitmq-user>
SPRING_RABBITMQ_PASSWORD='change-me'
SPRING_RABBITMQ_VIRTUAL_HOST=cardshop-trade-dev

LEGACY_CARD_SHOP_BASE_URL=
V1_CARDAPI_JWT_SECRET='change-me'

PID_DIR=
LOG_DIR=
