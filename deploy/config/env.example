# 开发、测试环境配置模板：复制为 config/.dev.env 或 config/.test.env 后填写实际值。
# 环境文件不得提交到 Git；密码和密钥不要写入 JAVA_OPTS，JVM 参数可被进程列表查看。
# 本文件由 Bash 加载，密码、JWT 密钥和接口密钥等敏感值使用单引号包裹，
# 尤其是含有 $、!、空格、反引号、&、|、;、< 或 > 等字符时。

APP_PROFILE=dev
SERVER_PORT=10080

# 启动脚本检查 JDK 21；服务器默认 JDK 不是 21 时，显式填写其安装路径。
CARD_SHOP_TRADE_JAVA_HOME=
JAVA_OPTS="-Xms512m -Xmx512m -XX:+UseG1GC -Dfile.encoding=UTF-8"

NACOS_SERVER_ADDR=<nacos-host>:8848
NACOS_NAMESPACE=cardshop-trade-engine-dev
NACOS_GROUP=TRADE_ENGINE_DEV
NACOS_USERNAME=nacos
NACOS_PASSWORD='change-me'

SPRING_RABBITMQ_HOST=<rabbitmq-host>
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=<rabbitmq-user>
SPRING_RABBITMQ_PASSWORD='change-me'
SPRING_RABBITMQ_VIRTUAL_HOST=cardshop-trade-dev

# Nacos Redis 配置引用 ${TRADE_ENGINE_REDIS_PASSWORD} 时需填写本环境实际密码。
TRADE_ENGINE_REDIS_PASSWORD='change-me'

LEGACY_CARD_SHOP_BASE_URL=
# 本环境独立生成的 token 签发密钥，不需要从旧系统复制。
V1_CARDAPI_JWT_SECRET='change-me'
# 本环境独立存储主密钥：随机32字节，采用无填充Base64URL编码，共43字符。
# 同环境各实例一致，重启时保留；不要复用JWT密钥、app_secret或aesKey。
V1_SIGNING_KEY_ENCRYPTION_KEY='change-me'

PID_DIR=
LOG_DIR=
