# Copy this file to config/env.dev, config/env.test, or config/env.prod.
# Keep only bootstrap settings here. MySQL, Redis, RabbitMQ, XXL-Job, and
# business switches should be managed in Nacos.

APP_PROFILE=dev
SERVER_PORT=8080

# The start script validates JDK 21. Set this explicitly when the server
# default JAVA_HOME points to another JDK version.
CARD_SHOP_TRADE_JAVA_HOME=
JAVA_OPTS="-Xms512m -Xmx512m -XX:+UseG1GC -Dfile.encoding=UTF-8"

NACOS_SERVER_ADDR=47.117.130.100:8848
NACOS_NAMESPACE=cardshop-trade-engine-dev
NACOS_GROUP=TRADE_ENGINE_DEV
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me

PID_DIR=
LOG_DIR=
