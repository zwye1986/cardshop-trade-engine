# A39 simulator runtime defaults.
# Copy this file to config/a39-simulator.env next to the packaged app and fill secrets there.
# Do not commit real app_secret or aesKey values.

export A39_APP_SECRET='***'
export A39_AES_KEY='***'

# Optional overrides:
# export CARD_SHOP_TRADE_JAVA_HOME='/opt/java/jdk-21.0.11'
